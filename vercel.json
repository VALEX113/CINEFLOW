export default async function handler(req, res) {
  res.setHeader('Access-Control-Allow-Origin', '*');
  res.setHeader('Access-Control-Allow-Methods', 'POST, OPTIONS');
  res.setHeader('Access-Control-Allow-Headers', 'Content-Type');
  if (req.method === 'OPTIONS') return res.status(200).end();
  if (req.method !== 'POST') return res.status(405).json({ error: 'Metodo non consentito' });

  const { history, shown } = req.body;
  if (!history || !Array.isArray(history) || history.length === 0)
    return res.status(400).json({ error: 'Descrizione mancante' });

  const GEMINI_KEY = process.env.GEMINI_API_KEY;
  if (!GEMINI_KEY) return res.status(500).json({ error: 'API key non configurata' });

  const excludeNote = shown && shown.length
    ? '\nNON mostrare questi film già mostrati: ' + shown.join(', ')
    : '';

  const histText = history.join('\n');

  const prompt = `Sei il più grande esperto cinematografico del mondo. Conosci TUTTI i film mai prodotti in qualsiasi lingua dal 1888 ad oggi — Hollywood, Bollywood, cinema italiano, francese, coreano, giapponese e ogni altra cinematografia mondiale.

COMPITO: Identificare con certezza il film che l'utente non ricorda.

INDIZI DELL'UTENTE:
${histText}
${excludeNote}

REGOLE:
1. Usa tutta la tua conoscenza cinematografica mondiale.
2. Una CITAZIONE tra virgolette è l'indizio più importante — identificala con certezza assoluta.
3. Ragiona per associazioni precise: "due amici bianco e nero + musica classica vinile + carcere America anni 90" = Le ali della libertà (1994) con la scena iconica del Mozart agli altoparlanti. "il moro geloso moglie" = Otello. "serial killer sette peccati" = Seven (1995).
4. Dai esattamente 5 risultati reali, ordinati per probabilità decrescente.
5. Sii PRECISO — spiega quale indizio specifico ha portato a quel film.
6. NON inventare film — usa solo film reali che conosci con certezza.

Rispondi SOLO con JSON valido, zero testo fuori:
{
  "verdict": "Ho identificato il film: [TITOLO]. [Spiegazione in prima persona max 25 parole]",
  "identified_title": "Titolo esatto",
  "results": [
    {
      "title": "Titolo esatto",
      "year": "Anno",
      "country": "Paese",
      "genre": "Genere",
      "director": "Regista",
      "cast": "Attori principali",
      "reason": "Indizio specifico che ha portato a questo film",
      "confidence": 95
    }
  ]
}`;

  try {
    const geminiRes = await fetch(
      `https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${GEMINI_KEY}`,
      {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          contents: [{ parts: [{ text: prompt }] }],
          generationConfig: {
            temperature: 0.1,
            maxOutputTokens: 1500
          }
        })
      }
    );

    if (!geminiRes.ok) {
      const err = await geminiRes.json();
      throw new Error(err.error?.message || 'Errore Gemini API: ' + geminiRes.status);
    }

    const data = await geminiRes.json();
    const raw = data.candidates?.[0]?.content?.parts?.[0]?.text || '';
    const clean = raw.replace(/```json|```/g, '').trim();
    const parsed = JSON.parse(clean);
    return res.status(200).json(parsed);

  } catch (err) {
    console.error('Detective error:', err.message);
    return res.status(500).json({ error: err.message });
  }
}
